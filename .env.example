# Supabase Configuration for Docs Storage
# Either SUPABASE_* or NEXT_PUBLIC_SUPABASE_* variable names are supported
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Can be your publishable key (sb_publishable_...), anon key, or service_role key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# The storage bucket containing your markdown documentation (default: interview-prep)
SUPABASE_BUCKET=interview-prep
