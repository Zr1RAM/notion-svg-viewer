# Supabase Configuration for Docs Storage (Build-time only, never sent to browser)
SUPABASE_URL=https://your-project.supabase.co
# Your Supabase publishable key (sb_publishable_...), anon key, or service_role key
SUPABASE_KEY=sb_publishable_your_key_here
# The storage bucket containing your markdown documentation (default: interview-prep)
SUPABASE_BUCKET=interview-prep
